# ══════════════════════════════════════════════════════════════════════
# openclaw-whatsapp-bot — variables de entorno (plantilla)
#
# Uso:  cp .env.example .env   y  editar .env con tus valores reales.
# El fichero .env NUNCA se commitea (ver .gitignore).
# Todas las variables están comentadas con su valor por defecto; descomenta
# y ajusta según tu despliegue.
# ══════════════════════════════════════════════════════════════════════

# ── Propietario (gating de DMs y comandos) ─────────────────────────────
# Número del propietario en formato E.164: +<codigo_pais><numero>, sin
# espacios, guiones ni corchetes. Usado en channels.whatsapp.allowFrom y
# commands.ownerAllowFrom (conf/openclaw.json via ${OWNER_PHONE}).
#OWNER_PHONE=+34600000000

# ── Token de autenticación del gateway ─────────────────────────────────
# Token compartido exigido por el gateway (gateway.auth.mode: "token" en
# conf/openclaw.json, vía ${OPENCLAW_GATEWAY_TOKEN}).
# Generar con:   openssl rand -hex 32
# IMPORTANTE: sin esta variable el gateway NO arranca (la resolución del
# secreto de gateway.auth.token falla y el arranque se bloquea). Descomenta
# esta línea en .env y define el valor antes de `docker compose up`.
#OPENCLAW_GATEWAY_TOKEN=

# ── Proveedor LLM (ISSUE-001 punto 5) ──────────────────────────────────
# Estrategia (RESEARCH-003 + RESEARCH-004, decisión del arquitecto):
#   · PRIMARIO:  Ollama Cloud vía el plugin oficial "ollama-cloud" de OpenClaw
#                (sin entrada en models.providers: el plugin descubre el
#                catálogo en vivo desde https://ollama.com/api/tags).
#   · FALLBACK:  Ollama local como servicio del docker-compose (perfil
#                "local-llm", OFF por defecto; ver docker-compose.yml).
#                La cadena queda fija en agents.entries.bot.model de
#                conf/openclaw.json:
#                  primary  = ${LLM_MODEL}
#                  fallbacks = ["ollama/qwen3:8b"]
# El fallback salta SOLO ante errores del primary (429/402/timeout...),
# turno local; no hay round-robin (RESEARCH-003 §5.4).

# Clave API de Ollama Cloud (plan Free 0 €, sin tarjeta). Crear en:
#   https://ollama.com/settings/keys   (no caduca; revocable)
# El plugin ollama-cloud la toma del entorno (env_file: .env del compose);
# sin ella el provider queda INACTIVO y el primary no funcionará.
# NOTA: esta variable NO se referencia en conf/openclaw.json (la lee el
# plugin directamente del entorno), por lo que `openclaw config validate`
# NO emite warning por ella aunque falte — el fallo solo aparece en
# runtime (provider inactivo) hasta que la pongas en .env.
#OLLAMA_API_KEY=

# Modelo primario del agente (agents.entries.bot.model.primary vía
# ${LLM_MODEL}; se sustituye dentro del objeto {primary, fallbacks}).
# Confirmar el id EXACTO tras tener la key con:
#   openclaw models list --provider ollama-cloud
# Alternativas gratuitas con tools (RESEARCH-004 §5.2):
#   ollama-cloud/gemma4:31b · ollama-cloud/nemotron-3-super
# Evitar como primary los tier High (p. ej. kimi-k3) y el default de
# onboarding minimax-m2.7 (riesgo de 402 en plan Free; RESEARCH-004 §5.2).
#LLM_MODEL=ollama-cloud/gpt-oss:20b

# Endpoint de Ollama LOCAL (models.providers.ollama.baseUrl vía
# ${OLLAMA_BASE_URL}). API nativa SIN /v1 — usar /v1 rompe el
# tool-calling (RESEARCH-003 §3.2).
# DESCOMENTA en .env: mientras esté sin definir, `openclaw config validate`
# y el arranque del gateway emiten el warning "missing env var
# OLLAMA_BASE_URL" (esperado hasta definirla; el fallback local no funciona
# sin ella).
# Por defecto apunta al servicio "ollama" del compose (red interna):
#OLLAMA_BASE_URL=http://ollama:11434
# Si prefieres Ollama instalado en el HOST en vez del servicio del compose:
#   OLLAMA_BASE_URL=http://host.docker.internal:11434
#   + añadir al servicio openclaw-gateway del docker-compose.yml:
#       extra_hosts: ["host.docker.internal:host-gateway"]
#   + Ollama escuchando en todas las interfaces (bind por defecto 127.0.0.1):
#       OLLAMA_HOST=0.0.0.0:11434 ollama serve
#   (implementación NO incluida en T-05c: documentada como alternativa)

# API key genérica del proveedor (LEGACY/COMPLEMENTO): se inyecta a
# OPENAI_API_KEY y ANTHROPIC_API_KEY desde conf/openclaw.json (bloque
# env.vars vía ${LLM_API_KEY}), solo si esas variables no están ya
# definidas. Con la estrategia Ollama NO hace falta: se queda comentada
# (genera el warning preexistente "missing env var LLM_API_KEY").
# ALTERNATIVA: definir directamente la variable nativa del proveedor
# (tiene prioridad sobre env.vars de config): OPENAI_API_KEY=sk-... ·
# ANTHROPIC_API_KEY=sk-ant-... (ver docs.openclaw.ai/help/environment)
#LLM_API_KEY=

# Proveedor elegido (informativo; la referencia activa es LLM_MODEL).
# Con la estrategia actual el valor sería: ollama-cloud
#LLM_PROVIDER=ollama-cloud

# ── Media (WhatsApp) ───────────────────────────────────────────────────
# Límite de media entrante/saliente en MB.
# NOTA (desviación D4, T-06): channels.whatsapp.mediaMaxMb del schema
# 2026.10.3 es `integer` y NO admite sustitución ${VAR} (sin coerción), por
# lo que conf/openclaw.json fija el literal 50. Esta variable la consumen
# las skills (p. ej. ytdl) para comprobar el tamaño antes de enviar.
# Valor por defecto del plugin: 50. El límite duro real de WhatsApp puede
# ser menor (se verificará empíricamente en T-16 y se ajustará aquí).
#MEDIA_MAX_MB=50

# Si es true, los archivos que se envían se entregan como documento
# (forceDocument) en lugar de como media nativa. Útil cuando el archivo
# supera el límite de media del canal.
#MEDIA_FORCE_DOCUMENT=false

# ── Gating de grupos ───────────────────────────────────────────────────
# JID del grupo de WhatsApp permitido (formato ...@g.us). Usado en
# channels.whatsapp.groupAllowFrom (conf/openclaw.json via
# ${GROUP_ALLOW_FROM}). Ej.: 123456789-987654@g.us
#GROUP_ALLOW_FROM=000000000-000000000@g.us
#
# Gating por mención (ISSUE-001 punto 4/7), fijado en conf/openclaw.json
# con claves del schema 2026.10.3:
#   channels.whatsapp.groups["*"].requireMention = true  (grupo solo bajo
#     mención: mensajes sin mención no se enrutan al agente)
#   agents.entries.bot.groupChat.unmentionedInbound = "room_event"
#     (defensa en profundidad: sin mención nunca es "user_request")
# Los patrones de texto de mención NO se declaran: se derivan de la
# identidad del agente (identity.name/emoji), ver docs de WhatsApp groups.

# Historial de mensajes de grupo inyectado al agente.
# NOTA (desviación D4, T-06): channels.whatsapp.historyLimit es `integer`
# en el schema 2026.10.3 y NO admite sustitución ${VAR}; la config fija el
# literal 50. Esta variable queda sin uso en conf/openclaw.json.
#WHATSAPP_HISTORY_LIMIT=50

# ── Montaje de skills (docker-compose) ─────────────────────────────────
# Modo del bind mount ./skills -> /home/node/.openclaw/skills.
# rw (por defecto) para desarrollo; cambiar a ro en producción.
#SKILLS_MOUNT_MODE=rw

# ── Identidad del bot ──────────────────────────────────────────────────
# JID completo del propio bot (numero@s.whatsapp.net). A CONFIRMAR en
# T-07 (verificación empírica con wacli): hasta entonces queda sin valor.
#BOT_JID=

# ── Zona horaria del contenedor ────────────────────────────────────────
#TZ=Europe/Madrid
